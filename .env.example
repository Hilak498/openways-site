# Copy to .env.local and fill in. Server-only values must NOT get a
# NEXT_PUBLIC_ prefix.

# --- Supabase: contact-form leads (public.leads) ---
# Project URL and the PUBLISHABLE key (Project Settings > API Keys).
# Never use the service_role / secret key here.
SUPABASE_URL=https://mcwywayyunufniofufod.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# --- CRM (/crm): lead board, behind a password ---
# Reads and writes the same public.leads table the form above writes to, so
# every enquiry shows up on the board. Needs the SECRET (service_role) key:
# the publishable key above may only insert, never read.
SUPABASE_SECRET_KEY=

# The shared password for /crm, and the key its session cookie is signed with.
# Without both, /crm refuses to let anyone in rather than running unprotected.
# Rotating CRM_SESSION_SECRET signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRM_PASSWORD=
CRM_SESSION_SECRET=

# --- Optional: email copy of each lead via Resend ---
RESEND_API_KEY=
CONTACT_INBOX=
CONTACT_FROM=

# --- Optional: Google reCAPTCHA v3 (server secret) ---
RECAPTCHA_SECRET_KEY=

# --- Optional: Google Analytics (public, consent-gated) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
